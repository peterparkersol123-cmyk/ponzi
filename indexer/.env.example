# HTTP RPC endpoint (required). Robinhood mainnet: https://rpc.mainnet.chain.robinhood.com
RPC_URL=

# Websocket RPC endpoint (strongly recommended for production streaming —
# use an Alchemy/QuickNode websocket URL; falls back to HTTP polling if unset).
WS_RPC_URL=

# Flap Portal (defaults to Robinhood mainnet, v5.14.15).
PORTAL_ADDRESS=0x26605f322f7fF986f381bB9A6e3f5DAb0bEaEb09

# The Flap-launched token address (required, ends in 7777).
TOKEN_ADDRESS=

# The deployed FlapJackpot contract address (required).
JACKPOT_ADDRESS=

# Block the token was launched at (backfill start). Default: 0.
START_BLOCK=0

# Port for the indexer's own websocket server the frontend connects to.
PORT=8787

# SQLite database file.
DB_PATH=./jackpot.db

# ---- keeper only (npm run keeper) ----
# Funded key for the referee bot that records buys and settles rounds. It can
# only call recordBuy/settle — it can never move the pot or ops funds.
KEEPER_PRIVATE_KEY=
# Chain id for signing (Robinhood mainnet = 4663).
CHAIN_ID=4663
